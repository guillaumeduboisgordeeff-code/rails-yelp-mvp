<h1 class="text-primary">Create a new restaurant</h1>

<%= simple_form_for(@restaurant) do |f| %>
  <%= f.input :name %>
  <%= f.input :address %>
  <%= f.input :category,
      collection: ["chinese", "italian", "japanese", "french", "belgian"],
      prompt: "choose a category" %>
  <%= f.submit %>
<% end %>
